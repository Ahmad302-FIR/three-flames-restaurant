# ==============================================================================
# AHMED KHAN RESTAURANT - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to backend/.env and frontend/.env as needed.
# NEVER commit real credentials to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (backend/.env or Render/Railway/Vercel)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Allowed frontend URL(s) for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/three-flames?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRES_IN=7d

# Cloudinary (Required for dish/gallery image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (Optional - logs to console if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=Ahmed Khan Restaurant <info.ahmadkhan.com@gmail.com>

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env or Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Backend API Base URL (e.g., http://localhost:5000/api or https://your-backend.onrender.com/api)
VITE_API_URL=http://localhost:5000/api

# Backend Realtime Socket URL (e.g., http://localhost:5000 or https://your-backend.onrender.com)
VITE_SOCKET_URL=http://localhost:5000
